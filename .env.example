# ── Reiwa OS environment (P0 Supabase model) ────────────────────────────────
# Backend selection: when DATABASE_URL is set the app uses PostgreSQL (Supabase)
# via the pg driver. When unset, a TRANSITIONAL embedded-Postgres fallback runs
# (deleted at P0 step 12 once the hosted path is proven).

# ── Supabase (reiwa-dev) — current key architecture ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase API credential (Auth Admin etc). NEVER exposed to the
# browser. Distinct from DATABASE_URL, which is the direct Postgres connection.
SUPABASE_SECRET_KEY=

# Direct Postgres connection for the pg driver.
# Supabase: use the TRANSACTION POOLER connection string for serverless.
DATABASE_URL=

# ── Application ─────────────────────────────────────────────────────────────
# Server-side pepper for hashing investor invite tokens (P1).
INVITE_TOKEN_PEPPER=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=

# ── Transitional (removed at P0 step 12) ────────────────────────────────────
# Legacy dev session-cookie secret while the embedded fallback is active.
AUTH_SECRET=
# Embedded fallback data directory (default ./.data/pg).
# PGLITE_DATA_DIR=
