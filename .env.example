# ── Reiwa OS environment ────────────────────────────────────────────────────
# Reiwa OS runs on Supabase: Supabase Auth for identity, Supabase PostgreSQL
# for data. Copy this file to .env.local and fill in the values. All four
# variables are required.
#
# You can point it at either:
#   * a LOCAL stack   — `npm run db:local` (Docker, works offline). Use the
#                       values printed by `npm run db:local:status`; the block
#                       at the foot of this file is the usual set.
#   * a HOSTED project — values from the Supabase dashboard.
#
# Integration tests DROP AND RECREATE the schema of whatever DATABASE_URL
# points at. Point them at the local stack, never at a project holding real
# deal data.

# ── Supabase HTTP API (Auth / PostgREST) ────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co  (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("anon") key — safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret ("service") key — SERVER ONLY. Used solely by the Admin API to
# provision Supabase Auth accounts during seeding. Never expose to a client.
SUPABASE_SECRET_KEY=

# ── Supabase PostgreSQL (privileged, RLS-gated at the session level) ────────
# Hosted: the transaction pooler (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
# This credential is kept strictly separate from the API keys above.
DATABASE_URL=

# Optional — the Supabase pooler certificate is issued by Supabase's own CA,
# which is not in the public trust store. The root is shipped at
# supabase/prod-ca-2021.crt and used automatically; set this to a PEM string or
# an alternative path to override it. TLS verification is always enabled.
# Not needed locally: `sslmode=disable` in DATABASE_URL skips TLS entirely.
# SUPABASE_DB_CA_CERT=

# Optional — local connection pool size (default 8).
# DATABASE_POOL_MAX=

# ── Local stack ─────────────────────────────────────────────────────────────
# `npm run db:local` starts Postgres, Auth, Storage and Studio in Docker and
# prints the keys below. They are fixed per CLI version, so this block is
# usually all you need:
#
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from `npm run db:local:status`>
#   SUPABASE_SECRET_KEY=<service_role key from `npm run db:local:status`>
#
# Then:  npm run db:reset -- --yes
